# Shell scripts must keep LF endings — CRLF breaks `bash script.sh` on the
# Linux cPanel server.
*.sh text eol=lf
.cpanel.yml text eol=lf

# Windows-only helper scripts.
*.ps1 text eol=crlf

# Binary assets — never normalize.
*.zip binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
