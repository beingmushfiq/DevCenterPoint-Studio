# ==============================================================================
# DevCenterPoint Studio — PRODUCTION environment template (cPanel)
# ==============================================================================
# Copy this to ~/dcp_core/.env on the server, fill in the secrets, then run:
#   php artisan key:generate
#
# This file is a TEMPLATE and is safe to commit — it contains no secrets.
# Never commit the real .env (it is gitignored).
# ==============================================================================

APP_NAME="DevCenterPoint"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://devcenterpoint.com
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# Database — cPanel MySQL
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=devcente_studio
DB_USERNAME=devcente_studiousr
DB_PASSWORD=w28T*Y9qKkj!J5

# ------------------------------------------------------------------------------
# Sessions / cache / queue (database-backed to avoid extra services)
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

CACHE_STORE=database
CACHE_PREFIX=

QUEUE_CONNECTION=database

# ------------------------------------------------------------------------------
# Mail — cPanel SMTP. Set a real mailbox before enabling the contact forms.
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=mail.devcenterpoint.com
MAIL_PORT=587
MAIL_USERNAME=hello@devcenterpoint.com
MAIL_PASSWORD=Hello@DCP2026
MAIL_FROM_ADDRESS="hello@devcenterpoint.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Vite (baked into the compiled assets at build time — informational only)
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
